{
  "description": "Context management: the Claude Code mod (context_mod.js) does session jumps, wakes, renames and token counts inside Claude Code; the shell hooks are the fallback when the mod is not loaded.",
  "modules": [
    "./context_mod.js"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/cm_stop.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/session_name.sh hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/session_name.sh hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
