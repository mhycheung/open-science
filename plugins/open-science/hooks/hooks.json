{
  "description": "Update check at session start and stop (shell hooks); the dispatch mod (dispatch_mod.js) submits the prompt of a session open-science:dispatch started.",
  "modules": [
    "./dispatch_mod.js"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/update_check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/update_check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
